[Unit]
Description=NovaMail - multi-account mail service
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=nobody
Group=nobody
WorkingDirectory=/var/lib/novamail
ExecStart=/usr/local/bin/novamail
Environment="NOVAMAIL_ENV=production"
Environment="NOVAMAIL_PORT=8080"
Environment="NOVAMAIL_HOST=0.0.0.0"
Environment="NOVAMAIL_DSN=/var/lib/novamail/data/novamail.db"
Environment="NOVAMAIL_POLL_INTERVAL=60"
Environment="NOVAMAIL_IDLE_ENABLED=true"
Environment="NOVAMAIL_MAX_CONCURRENT=10"
Environment="NOVAMAIL_SYNC_BATCH_SIZE=50"
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/novamail/data
PrivateTmp=true
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=novamail

[Install]
WantedBy=multi-user.target
