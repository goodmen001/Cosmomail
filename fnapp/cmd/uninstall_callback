#!/bin/bash

### 卸载回调：根据用户在卸载向导中的选择处理邮件数据
###   purge_data=keep  → 保留数据（下次安装可继续使用）
###   purge_data=purge → 删除全部数据（数据库、附件、运行文件）

LOG_PREFIX="[uninstall]"

# 数据目录解析逻辑与 cmd/main 保持一致：
#   1. config/resource data-share 声明的 cosmomail-data 共享目录
#      （TRIM_DATA_SHARE_PATHS 首个路径，或 /var/apps/*/share/cosmomail-data）
#   2. 回退 TRIM_PKGVAR/data
resolve_data_dir() {
    local share
    if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
        share="${TRIM_DATA_SHARE_PATHS%%:*}"
        if [ -n "${share}" ] && [ -d "${share}" ]; then
            printf '%s' "${share}"
            return 0
        fi
    fi
    for share in /var/apps/*/share/cosmomail-data; do
        if [ -d "${share}" ]; then
            printf '%s' "${share}"
            return 0
        fi
    done
    printf '%s' "${TRIM_PKGVAR}/data"
}

case "${purge_data:-keep}" in
    purge)
        DATA_DIR="$(resolve_data_dir)"
        # 删除全部可能的数据位置（数据库、附件、上传文件）：
        # 1. data-share 共享目录 / 默认数据目录
        if [ -d "${DATA_DIR}" ]; then
            rm -rf "${DATA_DIR}" 2>/dev/null
        fi
        # 2. 运行时文件（日志、pid、数据目录指针）
        rm -f "${TRIM_PKGVAR}/cosmomail.log" "${TRIM_PKGVAR}/cosmomail.pid"
        rm -rf "${TRIM_PKGVAR}/data" 2>/dev/null
        rm -f "${TRIM_PKGETC}/data_dir"
        ;;
    *)
        # 保留数据：不做任何删除，下次安装沿用原数据库
        ;;
esac

exit 0
