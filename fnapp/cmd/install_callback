#!/bin/bash

PORT="${wizard_port:-8800}"
case "${PORT}" in
    ''|*[!0-9]*)
        echo "端口必须是数字" > "${TRIM_TEMP_LOGFILE}"
        exit 1
        ;;
esac
if [ "${PORT}" -lt 10 ] || [ "${PORT}" -gt 65535 ]; then
    echo "端口必须在 10 到 65535 之间" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi
if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -Eq "[:.]${PORT}[[:space:]]"; then
    echo "端口 ${PORT} 已被占用，请返回并选择其他端口" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi
if ! command -v ss >/dev/null 2>&1 && command -v netstat >/dev/null 2>&1 \
    && netstat -ltn 2>/dev/null | grep -Eq "[:.]${PORT}[[:space:]]"; then
    echo "端口 ${PORT} 已被占用，请返回并选择其他端口" > "${TRIM_TEMP_LOGFILE}"
    exit 1
fi
# 自定义数据目录（可选，绝对路径，便于备份）
DATA_DIR="${wizard_data_dir// /}"
if [ -n "${DATA_DIR}" ]; then
    case "${DATA_DIR}" in
        /*) ;;
        *)
            echo "数据目录必须是绝对路径（以 / 开头）" > "${TRIM_TEMP_LOGFILE}"
            exit 1
            ;;
    esac
    if ! mkdir -p "${DATA_DIR}" 2>/dev/null || ! touch "${DATA_DIR}/.write_test" 2>/dev/null || ! rm -f "${DATA_DIR}/.write_test" 2>/dev/null; then
        # 目录不可写（fnOS 共享文件夹的"任意用户可读写"不包含应用服务账号）。
        # 不阻断安装，回退到默认数据目录，保证应用一定能装上。
        echo "数据目录 ${DATA_DIR} 不可写，已自动改用默认数据目录（安装可继续）" > "${TRIM_TEMP_LOGFILE}"
        DATA_DIR=""
        rm -f "${TRIM_PKGETC}/data_dir"
    fi
fi
mkdir -p "${TRIM_PKGETC}"
printf '%s\n' "${PORT}" > "${TRIM_PKGETC}/port"
if [ -n "${DATA_DIR}" ]; then
    printf '%s\n' "${DATA_DIR}" > "${TRIM_PKGETC}/data_dir"
else
    rm -f "${TRIM_PKGETC}/data_dir"
fi
exit 0
