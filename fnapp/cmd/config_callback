#!/bin/bash

PORT="${wizard_port:-8800}"
case "${PORT}" in
    ''|*[!0-9]*)
        exit 1
        ;;
esac
if [ "${PORT}" -lt 10 ] || [ "${PORT}" -gt 65535 ]; then
    exit 1
fi
# 自定义数据目录（可选，绝对路径）：仅保存，启动时做可写性验证
DATA_DIR="${wizard_data_dir// /}"
mkdir -p "${TRIM_PKGETC}"
printf '%s\n' "${PORT}" > "${TRIM_PKGETC}/port"
if [ -n "${DATA_DIR}" ]; then
    case "${DATA_DIR}" in
        /*) printf '%s\n' "${DATA_DIR}" > "${TRIM_PKGETC}/data_dir" ;;
        *) rm -f "${TRIM_PKGETC}/data_dir" ;;
    esac
else
    rm -f "${TRIM_PKGETC}/data_dir"
fi
exit 0
