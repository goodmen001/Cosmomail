#!/bin/bash

PORT="${wizard_port:-8800}"
case "${PORT}" in
    ''|*[!0-9]*)
        exit 1
        ;;
esac
if [ "${PORT}" -lt 10 ] || [ "${PORT}" -gt 65535 ]; then
    exit 1
fi
# 数据目录：由 config/resource 的 data-share 声明（cosmomail-data 共享目录），
# 不再支持手动指定，故仅保存端口。
mkdir -p "${TRIM_PKGETC}"
printf '%s\n' "${PORT}" > "${TRIM_PKGETC}/port"
rm -f "${TRIM_PKGETC}/data_dir"
exit 0
