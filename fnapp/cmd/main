#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/novamail.log"
PID_FILE="${TRIM_PKGVAR}/novamail.pid"

# 数据目录解析（按官方规范实现自定义目录，优先级从高到低）：
#   1. 安装向导填写的自定义目录（TRIM_PKGETC/data_dir，写测试通过才采用）
#   2. 管理员「应用共享授权」目录（官方 trim.file.sharedAccess 机制，
#      fnOS 应用设置中授权后系统自动授予应用账号 ACL 权限，数据落在
#      <授权目录>/novamail-data，文件管理器可见可备份）
#   3. config/resource 声明的 data-share 共享目录（TRIM_DATA_SHARE_PATHS，
#      安装时系统自动创建 novamail-data 共享文件夹）
#   4. TRIM_PKGVAR/data（官方运行数据目录，最终兜底）
# 查询管理员「应用共享授权」目录（仅管理员可授权，应用账号只读查询结果）
query_authorized_dir() {
    [ -n "${TRIM_API_TOKEN}" ] && [ -S "/var/run/trim_open_gateway_apiscope.socket" ] || return 1
    command -v curl >/dev/null 2>&1 || return 1
    curl -s --max-time 5 --unix-socket /var/run/trim_open_gateway_apiscope.socket \
        -X POST http://localhost/api/v1/trimapp \
        -H 'Content-Type: application/json' \
        -H "Authorization: Bearer ${TRIM_API_TOKEN}" \
        -d "{\"reqId\":\"1\",\"req\":\"trim.file.getSharedAccessibleFolders\",\"appName\":\"com.goodmen001.novamail\",\"data\":{}}" \
        2>/dev/null \
        | sed -n 's/.*"paths":\[[^]]*"\([^"]*\)".*/\1/p' | head -n 1
}

write_test() {
    mkdir -p "$1" 2>/dev/null && touch "$1/.write_test" 2>/dev/null \
        && rm -f "$1/.write_test" 2>/dev/null
}

resolve_data_dir() {
    local share custom
    # 1. 向导自定义目录
    if [ -r "${TRIM_PKGETC}/data_dir" ]; then
        custom="$(head -n 1 "${TRIM_PKGETC}/data_dir" | tr -d '[:space:]')"
        case "${custom}" in
            /*) if write_test "${custom}"; then
                    printf '%s' "${custom}"
                    return 0
                fi ;;
        esac
    fi
    # 2. 管理员共享授权目录（数据放在其下 novamail-data 子目录）
    share="$(query_authorized_dir)"
    if [ -n "${share}" ] && write_test "${share}/novamail-data"; then
        printf '%s' "${share}/novamail-data"
        return 0
    fi
    # 3. data-share 声明的共享目录（可能是 "path1:path2"，取第一个）
    if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
        share="${TRIM_DATA_SHARE_PATHS%%:*}"
        if [ -n "${share}" ] && write_test "${share}"; then
            printf '%s' "${share}"
            return 0
        fi
    fi
    # 3b. data-share 不可用时（旧版升级/变量缺失），尝试 /var/apps/<appname>/share 软链
    for share in /var/apps/*/share/novamail-data; do
        if [ -d "${share}" ] && write_test "${share}"; then
            printf '%s' "${share}"
            return 0
        fi
    done
    # 4. 最终兜底
    printf '%s' "${TRIM_PKGVAR}/data"
    return 0
}
DATA_DIR="$(resolve_data_dir)"

APP_BIN="${TRIM_APPDEST}/server/novamail"
PORT_FILE="${TRIM_PKGETC}/port"
APP_PORT="${wizard_port:-${TRIM_SERVICE_PORT:-8800}}"

if [ -r "${PORT_FILE}" ]; then
    saved_port="$(head -n 1 "${PORT_FILE}" | tr -d '[:space:]')"
    case "${saved_port}" in
        ''|*[!0-9]*) ;;
        *) APP_PORT="${saved_port}" ;;
    esac
fi

log_msg() {
    printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

read_pid() {
    [ -r "${PID_FILE}" ] || return 1
    head -n 1 "${PID_FILE}" | tr -d '[:space:]'
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    local pid
    pid="$(read_pid)" || return 1
    if check_process "${pid}"; then
        return 0
    fi
    rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    # resolve_data_dir 已验证可写性；这里仅确保目录存在
    if ! mkdir -p "${DATA_DIR}" 2>/dev/null; then
        log_msg "数据目录 ${DATA_DIR} 创建失败"
        return 1
    fi
    chmod 700 "${DATA_DIR}" 2>/dev/null
    chmod +x "${APP_BIN}" 2>/dev/null
    log_msg "Starting NovaMail on port ${APP_PORT} (data dir: ${DATA_DIR})"

    (
        cd "${TRIM_PKGVAR}" || exit 1
        export NOVAMAIL_ENV=production
        export NOVAMAIL_HOST=0.0.0.0
        export NOVAMAIL_PORT="${APP_PORT}"
        export NOVAMAIL_DSN="${DATA_DIR}/novamail.db"
        export NOVAMAIL_DATA_DIR="${DATA_DIR}"
        exec "${APP_BIN}"
    ) >> "${LOG_FILE}" 2>&1 &

    printf '%s' "$!" > "${PID_FILE}"
    # 首次启动需完成数据库迁移，等待最长 15 秒确认进程存活
    local count=0
    while [ "${count}" -lt 15 ]; do
        if status; then
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    if ! status; then
        log_msg "NovaMail failed to start"
        return 1
    fi
    return 0
}

stop_process() {
    local pid
    pid="$(read_pid)" || return 0
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "Stopping NovaMail (pid=${pid})"
    kill -TERM "${pid}" 2>/dev/null || true
    local count=0
    while check_process "${pid}" && [ "${count}" -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
