#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/cosmomail.log"
PID_FILE="${TRIM_PKGVAR}/cosmomail.pid"
# 自定义数据目录（安装/设置向导填写，保存在 etc/data_dir；为空则使用应用数据目录）
DATA_DIR="${TRIM_PKGVAR}/data"
if [ -r "${TRIM_PKGETC}/data_dir" ]; then
    CUSTOM_DATA_DIR="$(head -n 1 "${TRIM_PKGETC}/data_dir" | tr -d '[:space:]')"
    case "${CUSTOM_DATA_DIR}" in
        /*) DATA_DIR="${CUSTOM_DATA_DIR}" ;;
    esac
fi
APP_BIN="${TRIM_APPDEST}/server/cosmomail"
PORT_FILE="${TRIM_PKGETC}/port"
APP_PORT="${wizard_port:-${TRIM_SERVICE_PORT:-8800}}"

# 查询管理员「应用共享授权」的目录（fnOS 开放 API，Unix Socket + TRIM_API_TOKEN）
query_authorized_dir() {
    [ -n "${TRIM_API_TOKEN}" ] && [ -S "/var/run/trim_open_gateway_apiscope.socket" ] || return 1
    command -v curl >/dev/null 2>&1 || return 1
    curl -s --max-time 5 --unix-socket /var/run/trim_open_gateway_apiscope.socket \
        -X POST http://localhost/api/v1/trimapp \
        -H 'Content-Type: application/json' \
        -H "Authorization: Bearer ${TRIM_API_TOKEN}" \
        -d "{\"reqId\":\"1\",\"req\":\"trim.file.getSharedAccessibleFolders\",\"appName\":\"com.goodmen001.cosmomail\",\"data\":{}}" \
        2>/dev/null \
        | sed -n 's/.*"paths":\[[^]]*"\([^"]*\)".*/\1/p' | head -n 1
}

if [ -r "${PORT_FILE}" ]; then
    saved_port="$(head -n 1 "${PORT_FILE}" | tr -d '[:space:]')"
    case "${saved_port}" in
        ''|*[!0-9]*) ;;
        *) APP_PORT="${saved_port}" ;;
    esac
fi

log_msg() {
    printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

read_pid() {
    [ -r "${PID_FILE}" ] || return 1
    head -n 1 "${PID_FILE}" | tr -d '[:space:]'
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    local pid
    pid="$(read_pid)" || return 1
    if check_process "${pid}"; then
        return 0
    fi
    rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    # 自定义数据目录必须可写（应用以低权限用户运行）；不可写时依次回退：
    # 1. 管理员「应用共享授权」目录（系统会自动授予应用账号 ACL 权限）
    # 2. 默认数据目录，保证数据库/附件能创建、应用能启动
    if ! mkdir -p "${DATA_DIR}" 2>/dev/null || ! touch "${DATA_DIR}/.write_test" 2>/dev/null; then
        AUTH_DIR="$(query_authorized_dir)"
        if [ -n "${AUTH_DIR}" ] && mkdir -p "${AUTH_DIR}/cosmomail-data" 2>/dev/null \
            && touch "${AUTH_DIR}/cosmomail-data/.write_test" 2>/dev/null; then
            rm -f "${AUTH_DIR}/cosmomail-data/.write_test" 2>/dev/null
            log_msg "数据目录 ${DATA_DIR} 不可写，改用管理员授权目录 ${AUTH_DIR}/cosmomail-data"
            DATA_DIR="${AUTH_DIR}/cosmomail-data"
        else
            log_msg "数据目录 ${DATA_DIR} 不可写，回退到默认目录 ${TRIM_PKGVAR}/data"
            DATA_DIR="${TRIM_PKGVAR}/data"
            mkdir -p "${DATA_DIR}" 2>/dev/null
        fi
    fi
    rm -f "${DATA_DIR}/.write_test" 2>/dev/null
    chmod 700 "${DATA_DIR}" 2>/dev/null
    chmod +x "${APP_BIN}" 2>/dev/null
    log_msg "Starting Cosmo Mail on port ${APP_PORT} (data dir: ${DATA_DIR})"

    (
        cd "${TRIM_PKGVAR}" || exit 1
        export COSMOMAIL_ENV=production
        export COSMOMAIL_HOST=0.0.0.0
        export COSMOMAIL_PORT="${APP_PORT}"
        export COSMOMAIL_DSN="${DATA_DIR}/cosmomail.db"
        export COSMOMAIL_DATA_DIR="${DATA_DIR}"
        exec "${APP_BIN}"
    ) >> "${LOG_FILE}" 2>&1 &

    printf '%s' "$!" > "${PID_FILE}"
    # 首次启动需完成数据库迁移，等待最长 15 秒确认进程存活
    local count=0
    while [ "${count}" -lt 15 ]; do
        if status; then
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    if ! status; then
        log_msg "Cosmo Mail failed to start"
        return 1
    fi
    return 0
}

stop_process() {
    local pid
    pid="$(read_pid)" || return 0
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "Stopping Cosmo Mail (pid=${pid})"
    kill -TERM "${pid}" 2>/dev/null || true
    local count=0
    while check_process "${pid}" && [ "${count}" -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
