#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/cosmomail.log"
PID_FILE="${TRIM_PKGVAR}/cosmomail.pid"

# 数据目录解析（对齐飞牛官方规范）：
#   首选 config/resource 声明的 data-share 共享目录（TRIM_DATA_SHARE_PATHS，
#   安装时系统自动创建并授予应用账号 ACL 权限，文件管理器可直接查看/备份）；
#   回退 TRIM_PKGVAR/data（官方运行数据目录，数据库/运行文件所在）。
resolve_data_dir() {
    local share
    if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
        # 可能是 "path1:path2"，取第一个
        share="${TRIM_DATA_SHARE_PATHS%%:*}"
        if [ -n "${share}" ] && mkdir -p "${share}" 2>/dev/null && touch "${share}/.write_test" 2>/dev/null; then
            rm -f "${share}/.write_test" 2>/dev/null
            printf '%s' "${share}"
            return 0
        fi
    fi
    # data-share 不可用时（旧版升级/变量缺失），尝试 /var/apps/<appname>/share 软链
    for share in /var/apps/*/share/cosmomail-data; do
        if [ -d "${share}" ] && touch "${share}/.write_test" 2>/dev/null; then
            rm -f "${share}/.write_test" 2>/dev/null
            printf '%s' "${share}"
            return 0
        fi
    done
    printf '%s' "${TRIM_PKGVAR}/data"
    return 0
}
DATA_DIR="$(resolve_data_dir)"

APP_BIN="${TRIM_APPDEST}/server/cosmomail"
PORT_FILE="${TRIM_PKGETC}/port"
APP_PORT="${wizard_port:-${TRIM_SERVICE_PORT:-8800}}"

if [ -r "${PORT_FILE}" ]; then
    saved_port="$(head -n 1 "${PORT_FILE}" | tr -d '[:space:]')"
    case "${saved_port}" in
        ''|*[!0-9]*) ;;
        *) APP_PORT="${saved_port}" ;;
    esac
fi

log_msg() {
    printf '%s - %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

read_pid() {
    [ -r "${PID_FILE}" ] || return 1
    head -n 1 "${PID_FILE}" | tr -d '[:space:]'
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    local pid
    pid="$(read_pid)" || return 1
    if check_process "${pid}"; then
        return 0
    fi
    rm -f "${PID_FILE}"
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    # resolve_data_dir 已验证可写性；这里仅确保目录存在
    if ! mkdir -p "${DATA_DIR}" 2>/dev/null; then
        log_msg "数据目录 ${DATA_DIR} 创建失败"
        return 1
    fi
    chmod 700 "${DATA_DIR}" 2>/dev/null
    chmod +x "${APP_BIN}" 2>/dev/null
    log_msg "Starting Cosmo Mail on port ${APP_PORT} (data dir: ${DATA_DIR})"

    (
        cd "${TRIM_PKGVAR}" || exit 1
        export COSMOMAIL_ENV=production
        export COSMOMAIL_HOST=0.0.0.0
        export COSMOMAIL_PORT="${APP_PORT}"
        export COSMOMAIL_DSN="${DATA_DIR}/cosmomail.db"
        export COSMOMAIL_DATA_DIR="${DATA_DIR}"
        exec "${APP_BIN}"
    ) >> "${LOG_FILE}" 2>&1 &

    printf '%s' "$!" > "${PID_FILE}"
    # 首次启动需完成数据库迁移，等待最长 15 秒确认进程存活
    local count=0
    while [ "${count}" -lt 15 ]; do
        if status; then
            return 0
        fi
        sleep 1
        count=$((count + 1))
    done
    if ! status; then
        log_msg "Cosmo Mail failed to start"
        return 1
    fi
    return 0
}

stop_process() {
    local pid
    pid="$(read_pid)" || return 0
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        return 0
    fi

    log_msg "Stopping Cosmo Mail (pid=${pid})"
    kill -TERM "${pid}" 2>/dev/null || true
    local count=0
    while check_process "${pid}" && [ "${count}" -lt 15 ]; do
        sleep 1
        count=$((count + 1))
    done
    if check_process "${pid}"; then
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
