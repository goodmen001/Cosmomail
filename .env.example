# NovaMail native runtime configuration
NOVAMAIL_ENV=production
NOVAMAIL_HOST=0.0.0.0
NOVAMAIL_PORT=8080
NOVAMAIL_DSN=data/novamail.db

# Mail synchronization
NOVAMAIL_POLL_INTERVAL=60
NOVAMAIL_IDLE_ENABLED=true
NOVAMAIL_MAX_CONCURRENT=10
NOVAMAIL_SYNC_BATCH_SIZE=50

# Attachment cache
NOVAMAIL_AUTO_CACHE=false
NOVAMAIL_CACHE_THRESHOLD=2
NOVAMAIL_MIN_DISK_FREE=1024
NOVAMAIL_MAX_ATTACHMENT_SIZE=50

# Optional security configuration
# NOVAMAIL_JWT_SECRET=
# NOVAMAIL_ENCRYPT_KEY=
# NOVAMAIL_CORS_ORIGINS=https://mail.example.com
